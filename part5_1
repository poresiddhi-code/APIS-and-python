import requests
import json
import os
from datetime import datetime

# -----------------------------
# DATA
# -----------------------------

CITIES = {
    "delhi": (28.6139, 77.2090),
    "mumbai": (19.0760, 72.8777),
    "bangalore": (12.9716, 77.5946),
    "chennai": (13.0827, 80.2707),
    "kolkata": (22.5726, 88.3639),
    "hyderabad": (17.3850, 78.4867),
    "new york": (40.7128, -74.0060),
    "london": (51.5074, -0.1278),
    "tokyo": (35.6762, 139.6503),
    "sydney": (-33.8688, 151.2093),
}

CRYPTO_IDS = {
    "bitcoin": "btc-bitcoin",
    "ethereum": "eth-ethereum",
    "dogecoin": "doge-dogecoin",
    "cardano": "ada-cardano",
    "solana": "sol-solana",
    "ripple": "xrp-xrp",
}

# -----------------------------
# WEATHER
# -----------------------------

def get_weather(city):
    city = city.lower().strip()

    if city not in CITIES:
        print("City not found!")
        return None

    lat, lon = CITIES[city]

    url = "https://api.open-meteo.com/v1/forecast"
    params = {
        "latitude": lat,
        "longitude": lon,
        "current_weather": True,
        "timezone": "auto"
    }

    try:
        res = requests.get(url, params=params, timeout=10)
        res.raise_for_status()
        return res.json()
    except Exception as e:
        print("Weather error:", e)
        return None


def display_weather(city):
    data = get_weather(city)
    if not data:
        return

    w = data.get("current_weather", {})

    print("\n--- WEATHER REPORT ---")
    print("City:", city.title())
    print("Temp:", w.get("temperature"), "°C")
    print("Wind Speed:", w.get("windspeed"), "km/h")


# -----------------------------
# CRYPTO
# -----------------------------

def get_crypto(coin):
    coin = coin.lower().strip()
    coin_id = CRYPTO_IDS.get(coin, coin)

    url = f"https://api.coinpaprika.com/v1/tickers/{coin_id}"

    try:
        res = requests.get(url, timeout=10)
        res.raise_for_status()
        return res.json()
    except Exception as e:
        print("Crypto error:", e)
        return None


def display_crypto(coin):
    data = get_crypto(coin)

    if not data:
        print("Coin not found!")
        return

    usd = data["quotes"]["USD"]

    print("\n--- CRYPTO REPORT ---")
    print("Name:", data["name"])
    print("Price: $", usd["price"])
    print("24h Change:", usd["percent_change_24h"], "%")


# -----------------------------
# TOP CRYPTO
# -----------------------------

def get_top_crypto(limit=5):
    url = "https://api.coinpaprika.com/v1/tickers"

    try:
        res = requests.get(url, timeout=10)
        res.raise_for_status()
        return res.json()[:limit]
    except Exception as e:
        print("Error:", e)
        return None


def show_top_crypto():
    data = get_top_crypto()

    if not data:
        return

    print("\n--- TOP CRYPTO ---")
    for c in data:
        usd = c["quotes"]["USD"]
        print(c["name"], "-", usd["price"], "$")


