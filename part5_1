def save_to_file(data):
    with open("results.json", "w") as f:
        json.dump(data, f, indent=2)

    print("Saved to results.json")


# -----------------------------
# DASHBOARD
# -----------------------------

def dashboard():
    while True:
        print("\n====== DASHBOARD ======")
        print("1. Weather")
        print("2. Crypto")
        print("3. Top Crypto")
        print("4. POST Example")
        print("5. Save Sample Data")
